{
  "name": "opencode-context-watch",
  "version": "0.1.0",
  "description": "OpenCode plugin to warn when a session's context window usage crosses a configurable threshold",
  "main": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/FAZuH/context-watch"
  },
  "files": ["src"],
  "license": "MIT",
  "type": "module",
  "keywords": ["opencode", "plugin", "context-window"],
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "bundle": "bun build src/index.ts --outdir dist",
    "test": "echo \"no tests\" && exit 0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@opencode-ai/plugin": "1.18.7",
    "@opencode-ai/sdk": "1.18.7",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0"
  }
}
